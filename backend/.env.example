# Express Backend Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# Real Monitoring Service Endpoints (configured on Ubuntu 24.04 host)
PROMETHEUS_URL=http://172.17.0.1:19091
ALERTMANAGER_URL=http://172.17.0.1:19093

# Request Timeout in Milliseconds
METRICS_TIMEOUT_MS=4000

# Optional Jenkins Integration (leave empty if integration is pending)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB_NAME=5g-core-recovery

# Restricted Python Recovery API & Alertmanager Webhook Bridge (configured on Ubuntu 24.04 host)
RECOVERY_API_URL=
RECOVERY_BRIDGE_URL=
RECOVERY_API_TOKEN=
